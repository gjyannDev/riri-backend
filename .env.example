# Copy to .env and fill in real values. Never commit .env.
# Sections match the settings groups in app/core/config/.

# --- App (app/core/config/settings.py) ---
PROJECT_NAME="Riri Backend"
ENVIRONMENT=local  # local | staging | production
API_V1_PREFIX=/api/v1
# JSON list, e.g. ["http://localhost:3000"]
BACKEND_CORS_ORIGINS=[]

# --- Database (app/core/config/database.py) ---
DATABASE_URL=postgresql+psycopg://postgres:changeme@127.0.0.1:5434/riri
# compose.yaml only: the container's password, the same one as in DATABASE_URL.
POSTGRES_PASSWORD=changeme

# --- Logging (app/core/config/log.py) ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Console output locally, JSON elsewhere.
LOG_LEVEL=INFO

# --- Sentry (app/core/config/sentry.py) ---
# Leave SENTRY_DSN empty to send nothing. SENTRY_ENABLED=false turns Sentry off and keeps the DSN.
SENTRY_DSN=
SENTRY_ENABLED=true

# --- LLM (app/core/config/llm.py) ---
# Google AI Studio key and a Flash-class model, e.g. gemini-3.5-flash-lite (the model slice 1a was built with).
# Model names are retired over time (gemini-2.5-flash already returns 404), so check Google AI Studio.
# Both are required to run the coach.
LLM_PROVIDER=google_genai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=2
# Some Gemini 3.x models use fixed sampling and ignore temperature (the library warns); it is still logged as configured.
LLM_TEMPERATURE=0.7
# Gemini 3.x only: minimal | low | medium | high. minimal = lowest latency. Gemini 3.x rejects the older thinking_budget.
LLM_THINKING_LEVEL=minimal

# --- Langfuse tracing (app/core/config/langfuse.py) ---
# Off unless LANGFUSE_ENABLED=true; keys alone never start tracing. Message text is masked before it
# leaves the machine: only numbers, ids, prompt version and hash are sent. Keys: Langfuse project
# Settings -> API Keys. EU cloud is the default; the US cloud is https://us.cloud.langfuse.com.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Sends message text (not just numbers) to Langfuse so the preview shows it. Unset: on in local and
# staging, off in production. false: off everywhere. true in production is refused at startup.
# Staging and local must hold synthetic conversations only.
# LANGFUSE_CAPTURE_TEXT=false

# --- LangSmith (never on) ---
# build_coach() forces LangSmith tracing off whatever this says; there is no setting that turns it on.
LANGSMITH_TRACING=false
